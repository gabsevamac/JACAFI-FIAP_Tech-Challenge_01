<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Decisão técnica: Proteção CSRF desativada intencionalmente,
         pois a classe SecurityConfig configura uma API puramente
         stateless (JWT), imune a ataques convencionais de CSRF. -->
    <Match>
        <Class name="com.jacafi.tech.config.SecurityConfig"/>
        <Bug pattern="SPRING_CSRF_PROTECTION_DISABLED, THROWS_METHOD_THROWS_CLAUSE_BASIC_EXCEPTION"/>
    </Match>

    <!-- Falso Positivo no LOG -->
    <Match>
        <Class name="com.jacafi.tech.serviceorder.adapter.out.notification.ResendStatusEmailSender"/>
        <Bug pattern="CRLF_INJECTION_LOGS" />
    </Match>

    <Match>
        <Class name="com.jacafi.tech.shared.adapter.in.web.GlobalExceptionHandler"/>
        <Bug pattern="CRLF_INJECTION_LOGS" />
    </Match>

    <!-- Bug identificado mesmo depois de tratado. TODO: Validar -->
    <Match>
        <Class name="com.jacafi.tech.shared.adapter.in.security.KeycloakJwtAuthenticationConverter" />
        <Bug pattern="IMPROPER_UNICODE"/>
    </Match>

    <Match>
        <Class name="com.jacafi.tech.shared.adapter.in.web.SortableFields" />
        <Bug pattern="IMPROPER_UNICODE"/>
    </Match>

    <!--
        Bug identificado por conta de não estar sendo enviado como HTML,
        TODO: Avaliar se necessário enviar assim e validar se compensa criar um Record pra Response.
    -->
    <Match>
        <Class name="com.jacafi.tech.shared.adapter.in.web.SecurityProblemDetailHandler"/>
        <Bug pattern="XSS_SERVLET"/>
    </Match>

    <!--
    SPRING_ENDPOINT: "Bug" de log da biblioteca, não é um erro em si.
    CT_CONSTRUCTOR_THROW: Falso positivo ao lançar exceptions dentro de construtores, prática que segue o princípio do Fail-Fast (DDD)
    -->
    <Match>
        <Bug pattern="SPRING_ENDPOINT, CT_CONSTRUCTOR_THROW"/>
    </Match>

    <!-- Falso Positivo na injeção de Beans dentro dos construtores dos Controllers e Services -->
    <Match>
        <Class name="~.*\.(controller|service|dto|web)\..*"/>
        <Bug pattern="EI_EXPOSE_REP, EI_EXPOSE_REP2"/>
    </Match>
</FindBugsFilter>