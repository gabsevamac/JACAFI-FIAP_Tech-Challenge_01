<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<module name="Checker">

    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <module name="SuppressionFilter">
        <property name="file" value="${checkstyle.suppressions.file}" default=""/>
        <property name="optional" value="true"/>
    </module>

    <module name="TreeWalker">

        <module name="IllegalImport">
            <property name="id" value="jackson2Databind"/>
            <property name="illegalPkgs" value="com.fasterxml.jackson.databind"/>
            <message key="import.illegal"
                     value="Import proibido: {0}. O Boot 4 usa Jackson 3 — importe de tools.jackson.databind. O com.fasterxml.jackson.annotation continua liberado."/>
        </module>

        <module name="IllegalImport">
            <property name="id" value="legacyDateTypes"/>
            <property name="illegalPkgs" value=""/>
            <property name="illegalClasses" value="java.util.Date, java.sql.Timestamp"/>
            <message key="import.illegal"
                     value="Import proibido: {0}. Use java.time.Instant — a aplicacao opera em UTC e esses tipos carregam o fuso da maquina."/>
        </module>

        <module name="IllegalImport">
            <property name="id" value="lombok"/>
            <property name="illegalPkgs" value="lombok"/>
            <message key="import.illegal"
                     value="Import proibido: {0}. O Lombok foi removido do projeto — o @ToString gerado vazava dado pessoal em log. Escreva o metodo a mao, com mascaramento."/>
        </module>

    </module>
</module>
